{
  // setup.ts is an abandoned interactive .env wizard that has never parsed
  // (unbalanced braces from line 60 on) and is imported by nothing, built by
  // nothing, and documented nowhere. Excluded so the rest of the tree can be
  // checked; it should be deleted or finished rather than excluded forever.
  "exclude": ["setup.ts"],
  "tasks": {
    "start": "deno run --allow-all --unstable-node-globals main.ts",
    "test": "deno test --allow-all tests/",
    "test:unit": "deno test --allow-all tests/ --ignore=tests/integration/",
    "test:integration": "deno test --allow-all tests/integration/",
    "test:smoke": "deno test --allow-all tests/integration/smoke_test.ts",
    "check": "deno check *.ts && deno lint",
    "lint": "deno lint"
  },
  "lint": {
    "include": ["*.ts", "tests/**/*.ts"],
    "rules": {
      "exclude": [
        "no-import-prefix",
        "no-unversioned-import",
        "no-explicit-any",
        "require-await"
      ]
    }
  }
}
